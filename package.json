  "scripts": {
    "vscode:prepublish": "npm run compile",
    "coverage": "nyc mocha \"src/test/**/*.test.ts\"",
    "compile": "tsc -p ./",
    "lint": "tslint -p .",
    "check": "npm run compile && npm run lint && npm test",
    "watch": "tsc -watch -p ./",
    "test": "mocha \"src/test/**/*.test.ts\"",
    "unit-test": "mocha \"src/test/unit/**/*.test.ts\"",
    "acceptance-test": "mocha \"src/test/acceptance/**/*.test.ts\"",
    "test-mode": "mocha \"src/test/unit/**/*.test.ts\" --watch"
  },
