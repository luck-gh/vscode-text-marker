{
  "name": "text-marker-custom",
  "displayName": "Text Marker Custom",
  "description": "%extension.description%",
  "version": "1.14.2",
  "publisher": "luck-gh",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "images/text-marker-custom.png",
  "bugs": {
    "url": "https://github.com/luck-gh/vscode-text-marker/issues"
  },
  "homepage": "https://github.com/luck-gh/vscode-text-marker/blob/v1.14.2/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/luck-gh/vscode-text-marker.git"
  },
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mark",
    "marker",
    "match",
    "highlight",
    "search"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "textmarker.highlightColors": {
          "description": "%setting.highlightColors%",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "darkgoldenrod",
            "darkmagenta",
            "darkolivegreen",
            "darkslateblue",
            "darkslategray",
            "darkviolet",
            "darkblue",
            "darkturquoise",
            "darkgray",
            "darkkhaki",
            "darkorange",
            "darksalmon",
            "darkseagreen"
          ]
        },
        "textmarker.defaultHighlightColor": {
          "description": "%setting.defaultHighlightColor%",
          "type": "string",
          "default": "gray"
        },
        "textmarker.defaultHighlightOpacity": {
          "description": "%setting.defaultHighlightOpacity%",
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1
        },
        "textmarker.enableIgnoreCase": {
          "description": "%setting.enableIgnoreCase%",
          "type": "boolean",
          "default": false
        },
        "textmarker.enableWholeMatch": {
          "description": "%setting.enableWholeMatch%",
          "type": "boolean",
          "default": false
        },
        "textmarker.useHighlightColorOnRuler": {
          "description": "%setting.useHighlightColorOnRuler%",
          "type": "boolean",
          "default": true
        },
        "textmarker.autoSelectDistinctiveTextColor": {
          "description": "%setting.autoSelectDistinctiveTextColor%",
          "type": "boolean",
          "default": false
        },
        "textmarker.hideStatusBarItems": {
          "description": "%setting.hideStatusBarItems%",
          "type": "boolean",
          "default": false
        },
        "textmarker.delayForRefreshingHighlight": {
          "description": "%setting.delayForRefreshingHighlight%",
          "type": [
            "number",
            "null"
          ],
          "default": 300
        },
        "textmarker.commandsOnContextMenu": {
          "description": "%setting.commandsOnContextMenu%",
          "type": "object",
          "properties": {
            "toggleHighlight": {
              "type": "boolean"
            },
            "unhighlight": {
              "type": "boolean"
            },
            "clearAllHighlight": {
              "type": "boolean"
            },
            "updateHighlight": {
              "type": "boolean"
            },
            "goToNextHighlight": {
              "type": "boolean"
            },
            "goToPreviousHighlight": {
              "type": "boolean"
            }
          },
          "default": {
            "toggleHighlight": true,
            "unhighlight": true,
            "clearAllHighlight": true,
            "updateHighlight": true,
            "goToNextHighlight": true,
            "goToPreviousHighlight": true
          },
          "additionalProperties": false
        },
        "textmarker.savedHighlights": {
          "description": "%setting.savedHighlights%",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "regex"
                    ]
                  },
                  "expression": {
                    "type": "string"
                  },
                  "ignoreCase": {
                    "type": "boolean"
                  },
                  "wholeMatch": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "expression",
                  "ignoreCase",
                  "wholeMatch"
                ]
              },
              "color": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ]
          }
        },
        "textmarker.borderWidth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "%setting.borderWidth%"
        },
        "textmarker.borderStyle": {
          "type": "string",
          "default": "solid",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "double",
            "none"
          ],
          "enumDescriptions": [
            "%borderStyle.solid%",
            "%borderStyle.dashed%",
            "%borderStyle.dotted%",
            "%borderStyle.double%",
            "%borderStyle.none%"
          ],
          "description": "%setting.borderStyle%"
        },
        "textmarker.borderRadius": {
          "type": "number",
          "default": 999,
          "minimum": 0,
          "description": "%setting.borderRadius%"
        }
      }
    },
    "commands": [
      {
        "command": "textmarker.highlightUsingRegex",
        "title": "%command.highlightUsingRegex%",
        "category": "TextMarker"
      },
